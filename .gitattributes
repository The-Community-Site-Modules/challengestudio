# Normalise line endings. Committed content is always LF; Windows checkouts
# get CRLF locally. Keeps diffs clean between Windows dev and Ubuntu CI.
* text=auto eol=lf

# Binary / generated files git should not touch
pnpm-lock.yaml linguist-generated=true
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Windows-only script — must keep CRLF to run under cmd.exe
*.cmd text eol=crlf
