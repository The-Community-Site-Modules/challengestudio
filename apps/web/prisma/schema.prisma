// Prisma schema for Challenge Studio
// Database: Supabase (PostgreSQL) via shared pooler
//
// Runtime queries  → DATABASE_URL  (transaction-mode, port 6543, pgbouncer=true)
// Migrations       → DIRECT_URL    (session-mode, port 5432)
//
// Run after any schema change:
//   npx prisma generate          ← regenerate client types
//   npx prisma migrate dev       ← apply migration locally
//   npx prisma migrate deploy    ← apply migration in CI/production

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum ChallengeStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ChallengeMode {
  SELF_PACED
  COHORT
  LIVE_EVENT
  DRIP
  SPRINT
  EVERGREEN
  CERTIFICATION
  CHALLENGE_LADDER
}

enum StepBlockType {
  HEADING
  TEXT_RESPONSE
  FILE_UPLOAD
  VIDEO
  IMAGE
  DOWNLOAD
  CHECKLIST
  ASSIGNMENT
  REFLECTION
  DISCUSSION_PROMPT
}

enum ParticipantStatus {
  PENDING       // registered, awaiting creator approval
  REGISTERED
  ACTIVE
  COMPLETED
  DROPPED
}

// ─────────────────────────────────────────────────────────────────────────────
// USERS & WORKSPACES
// ─────────────────────────────────────────────────────────────────────────────

model Profile {
  id        String   @id // matches auth.users.id from Supabase Auth
  email     String   @unique
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspaceMemberships WorkspaceMember[]
  ownedWorkspaces      Workspace[]
  participations       Participant[]
  sentInvitations      WorkspaceInvitation[]
  notificationPrefs    NotificationPreference[]

  @@map("profiles")
}

model Workspace {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  logoUrl     String?  @map("logo_url")
  timezone    String   @default("UTC") @map("timezone")
  ownerId     String   @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner      Profile           @relation(fields: [ownerId], references: [id])
  members    WorkspaceMember[]
  challenges Challenge[]
  invitations WorkspaceInvitation[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  profileId   String        @map("profile_id")
  role        WorkspaceRole @default(MEMBER)
  invitedAt   DateTime?     @map("invited_at")
  joinedAt    DateTime?     @map("joined_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, profileId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique @default(cuid())
  invitedById String        @map("invited_by_id")
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   Profile   @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@map("workspace_invitations")
}

// ─────────────────────────────────────────────────────────────────────────────
// CHALLENGES
// ─────────────────────────────────────────────────────────────────────────────

model Challenge {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  slug        String
  title       String
  description String?

  // Outcome (Step 2)
  promise            String?  @map("promise")
  outcome            String?  @map("outcome")
  startingPoint      String?  @map("starting_point")
  successDefinition  String?  @map("success_definition")

  mode        ChallengeMode   @default(SELF_PACED)
  status      ChallengeStatus @default(DRAFT)
  coverImageUrl String?       @map("cover_image_url")

  // Schedule (Step 4)
  registrationOpensAt  DateTime? @map("registration_opens_at")
  registrationClosesAt DateTime? @map("registration_closes_at")
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  timezone    String?

  // Audience (Step 5)
  maxParticipants  Int?     @map("max_participants")
  isPublic         Boolean  @default(true) @map("is_public")
  requiresApproval Boolean  @default(false) @map("requires_approval")

  // Settings catch-all: feature flags, email triggers, offer config (Steps 6–8)
  settings Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps        ChallengeStep[]
  participants Participant[]
  feedPosts    FeedPost[]
  messageTemplates MessageTemplate[]
  liveSessions LiveSession[]
  offer        Offer?

  @@unique([workspaceId, slug])
  @@map("challenges")
}

model ChallengeStep {
  id          String  @id @default(cuid())
  challengeId String  @map("challenge_id")
  title       String
  description String?
  order       Int
  stepType    String  @default("day") @map("step_type") // orientation|day|graduation|bonus
  isRequired  Boolean @default(true) @map("is_required")
  isPublished Boolean @default(false) @map("is_published")

  // Builder settings
  estimatedMinutes Int?    @map("estimated_minutes")
  completionMethod String? @map("completion_method") // manual|required_blocks
  pointsXp         Int?    @map("points_xp")

  // Schedule (for drip mode)
  availableAt DateTime? @map("available_at")
  dueAt       DateTime? @map("due_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  challenge    Challenge      @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  contentBlocks ContentBlock[]
  submissions   Submission[]
  feedPosts     FeedPost[]

  @@map("challenge_steps")
}

model ContentBlock {
  id     String        @id @default(cuid())
  stepId String        @map("step_id")
  type   StepBlockType
  order  Int
  data   Json          // block-type-specific content

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  step ChallengeStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@map("content_blocks")
}

// ─────────────────────────────────────────────────────────────────────────────
// PARTICIPANTS & SUBMISSIONS
// ─────────────────────────────────────────────────────────────────────────────

model Participant {
  id          String            @id @default(cuid())
  challengeId String            @map("challenge_id")
  profileId   String            @map("profile_id")
  status      ParticipantStatus @default(REGISTERED)
  registeredAt DateTime         @default(now()) @map("registered_at")
  completedAt  DateTime?        @map("completed_at")

  challenge   Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  profile     Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  submissions Submission[]
  posts       FeedPost[]
  comments    FeedComment[]
  reactions   Reaction[]
  pointsEvents PointsEvent[]
  badgeAwards BadgeAward[]

  @@unique([challengeId, profileId])
  @@map("participants")
}

model Submission {
  id            String   @id @default(cuid())
  participantId String   @map("participant_id")
  stepId        String   @map("step_id")
  data          Json     // submitted content
  submittedAt   DateTime @default(now()) @map("submitted_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  participant Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  step        ChallengeStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([participantId, stepId])
  @@map("submissions")
}


// ─────────────────────────────────────────────────────────────────────────────
// COMMUNITY (Milestone 7)
// ─────────────────────────────────────────────────────────────────────────────

/// A post in a challenge's feed. Written by a participant, optionally tied to
/// the step they were on when they wrote it.
///
/// Moderation hides rather than deletes: a removed post stays auditable, and
/// "who removed this and when" is a question moderators need answered.
model FeedPost {
  id            String    @id @default(cuid())
  challengeId   String    @map("challenge_id")
  participantId String    @map("participant_id")
  stepId        String?   @map("step_id")
  body          String
  isHidden      Boolean   @default(false) @map("is_hidden")
  hiddenById    String?   @map("hidden_by_id")
  hiddenAt      DateTime? @map("hidden_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  challenge   Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  participant Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  step        ChallengeStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  comments    FeedComment[]
  reactions   Reaction[]

  @@index([challengeId, createdAt])
  @@map("feed_posts")
}

model FeedComment {
  id            String    @id @default(cuid())
  postId        String    @map("post_id")
  participantId String    @map("participant_id")
  body          String
  isHidden      Boolean   @default(false) @map("is_hidden")
  hiddenById    String?   @map("hidden_by_id")
  hiddenAt      DateTime? @map("hidden_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  post        FeedPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("feed_comments")
}

/// One emoji from one participant on one post. The unique constraint is what
/// makes reacting idempotent — a double click toggles rather than stacking.
model Reaction {
  id            String   @id @default(cuid())
  postId        String   @map("post_id")
  participantId String   @map("participant_id")
  emoji         String
  createdAt     DateTime @default(now()) @map("created_at")

  post        FeedPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([postId, participantId, emoji])
  @@map("reactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// GAMIFICATION (Milestone 7)
// ─────────────────────────────────────────────────────────────────────────────

/// Append-only points ledger (Build Plan data rule 2: progress is derived, not
/// mutated, so it stays auditable and recalculable).
///
/// idempotencyKey is unique and carries the whole point: awarding the same
/// action twice is a no-op at the database level rather than something the
/// caller has to remember not to do.
model PointsEvent {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  challengeId    String   @map("challenge_id")
  participantId  String   @map("participant_id")
  action         String
  points         Int
  sourceId       String?  @map("source_id")
  idempotencyKey String   @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([challengeId, participantId])
  @@map("points_events")
}

/// Badges themselves are defined in code (lib/gamification/badges); only the
/// award is a row. One table instead of two, and no seeding step that can drift
/// from the definitions the code actually checks.
model BadgeAward {
  id            String   @id @default(cuid())
  challengeId   String   @map("challenge_id")
  participantId String   @map("participant_id")
  badgeKey      String   @map("badge_key")
  awardedAt     DateTime @default(now()) @map("awarded_at")

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, badgeKey])
  @@map("badge_awards")
}


// ─────────────────────────────────────────────────────────────────────────────
// COMMUNICATIONS (Milestone 8)
// ─────────────────────────────────────────────────────────────────────────────

/// A creator's override for one message type on one challenge.
///
/// The catalogue itself lives in code (lib/communications/catalogue) — same
/// reasoning as badges. A row exists only where a creator has changed
/// something, so there is no seeding step and no template that can drift from
/// the trigger the code fires. Null subject/body mean "use the default".
model MessageTemplate {
  id          String   @id @default(cuid())
  challengeId String   @map("challenge_id")
  trigger     String
  enabled     Boolean  @default(true)
  subject     String?
  body        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, trigger])
  @@map("message_templates")
}

/// Every send attempt, whether it worked or not.
///
/// PRD §27: "Core transactional triggers are sent once, delivery failures are
/// observable." Both live here — the unique idempotency key is what makes
/// "once" true at the database level rather than by caller discipline, and a
/// failure is a row with status 'failed' rather than a silent nothing.
model MessageDelivery {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  challengeId    String?  @map("challenge_id")
  participantId  String?  @map("participant_id")
  recipientEmail String   @map("recipient_email")
  trigger        String
  /// sent | failed | skipped_unsubscribed | skipped_disabled
  status         String
  provider       String?
  error          String?
  idempotencyKey String   @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([challengeId, trigger])
  @@map("message_deliveries")
}

/// Unsubscribe, scoped to one workspace.
///
/// PRD §15.2: "Workspace unsubscribe behavior should not accidentally
/// unsubscribe a person from unrelated products or workspaces." The unique key
/// is (profile, workspace) precisely so opting out of one says nothing about
/// any other. Essential mail — access and security — ignores this entirely.
model NotificationPreference {
  id           String   @id @default(cuid())
  profileId    String   @map("profile_id")
  workspaceId  String   @map("workspace_id")
  unsubscribed Boolean  @default(false)
  updatedAt    DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, workspaceId])
  @@map("notification_preferences")
}


// ─────────────────────────────────────────────────────────────────────────────
// LIVE SESSIONS & OFFER (Milestone 9)
// ─────────────────────────────────────────────────────────────────────────────

/// A scheduled call attached to a challenge (PRD §16).
///
/// joinUrl is deliberately not part of any public query. §16: "External join
/// URLs must be protected from public discovery when the challenge is
/// private" — so it is selected only for enrolled participants.
model LiveSession {
  id              String    @id @default(cuid())
  challengeId     String    @map("challenge_id")
  title           String
  description     String?
  startsAt        DateTime  @map("starts_at")
  durationMinutes Int?      @map("duration_minutes")
  hostName        String?   @map("host_name")
  joinUrl         String?   @map("join_url")
  replayUrl       String?   @map("replay_url")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId, startsAt])
  @@map("live_sessions")
}

/// The post-challenge call to action (PRD §12.2).
///
/// External only: "The MVP may support a configured CTA to an external
/// checkout or sales page." Nothing here takes payment, and one offer per
/// challenge is enough for that.
model Offer {
  id          String    @id @default(cuid())
  challengeId String    @unique @map("challenge_id")
  enabled     Boolean   @default(false)
  headline    String
  body        String?
  ctaLabel    String    @default("Get started") @map("cta_label")
  ctaUrl      String    @map("cta_url")
  /// Bullet points, stored as a JSON array of strings.
  bonuses     Json?
  /// Question/answer pairs, stored as a JSON array of objects.
  faq         Json?
  closesAt    DateTime? @map("closes_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  challenge Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  clicks    OfferClick[]

  @@map("offers")
}

/// One click through to the external page.
///
/// PRD §8.1 step 43 asks creators to "monitor registrations, participation,
/// submissions, attendance, completion, and offer clicks". This is that last
/// one — an event row rather than a counter, so it stays auditable like points.
model OfferClick {
  id            String   @id @default(cuid())
  offerId       String   @map("offer_id")
  participantId String?  @map("participant_id")
  clickedAt     DateTime @default(now()) @map("clicked_at")

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, clickedAt])
  @@map("offer_clicks")
}
