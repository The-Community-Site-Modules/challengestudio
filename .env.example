# ═══════════════════════════════════════════════════════════════════
# CHALLENGE STUDIO — Environment Variables
# Copy this file to apps/web/.env.local and fill in values.
# NEVER commit .env.local or any file with real secrets.
# ═══════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Challenge Studio

# ── Supabase (Auth + Database) ───────────────────────────────────────
# Get these from: Supabase Dashboard → Project → API Keys

# Project URL — safe to expose to browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key — safe to expose to browser (replaces legacy anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key — SERVER ONLY, never expose to browser or commit to git
SUPABASE_SECRET_KEY=sb_secret_...

# JWKS URL for JWT verification in API routes / Edge Functions
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# ── Database (Prisma + Supabase Pooler) ──────────────────────────────
# Get from: Supabase Dashboard → Project → Connect → ORM → Prisma
# NOTE: If your password contains special characters, percent-encode them
#   @ → %40   # → %23   % → %25   : → %3A

# Transaction-mode pooler — used by Prisma at runtime (port 6543)
# pgbouncer=true is required for transaction-mode pooler
DATABASE_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode pooler — used by Prisma for migrations only (port 5432)
DIRECT_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# ── Email (Resend) ────────────────────────────────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY=re_...
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Challenge Studio

# ── File Storage (Cloudflare R2) ─────────────────────────────────────
# Get from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=challenge-studio-uploads
# Public URL for the R2 bucket (custom domain or R2.dev subdomain)
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ── Background Jobs (Inngest) ─────────────────────────────────────────
# Get from: https://app.inngest.com → Your App → Keys
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Rate Limiting (Upstash Redis) ────────────────────────────────────
# Get from: https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Error Monitoring (Sentry) ─────────────────────────────────────────
# Get from: https://sentry.io → Project → Settings → SDK Setup
NEXT_PUBLIC_SENTRY_DSN=
# Used for source map uploads during CI build only
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Community Site Integration ────────────────────────────────────────
# Shared HMAC secret for server-to-server handshake
# Must match secret configured on the Community Site side
INTEGRATION_HMAC_SECRET=
# Max age for launch tokens in seconds (recommended: 60)
INTEGRATION_TOKEN_MAX_AGE_SECONDS=60

# ── Platform Admin ────────────────────────────────────────────────────
# Email of the bootstrap platform admin account (set once during setup)
PLATFORM_ADMIN_EMAIL=
